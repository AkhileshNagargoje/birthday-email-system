# Copy this file to ".env" and fill in real values.
# NEVER commit .env — it holds your mail password.

# ---- Sender account ----------------------------------------------------
# While developing, use a throwaway Gmail with 2FA + an App Password.
# Swap in the college address later; nothing else needs to change.
EMAIL_USER=you@example.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Name students see in the "From" line
EMAIL_FROM_NAME=Your College

# Where replies should go (optional; defaults to EMAIL_USER)
REPLY_TO=

# ---- SMTP server -------------------------------------------------------
# Gmail / Google Workspace
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Office 365 would be: smtp.office365.com / 587

# ---- Safety ------------------------------------------------------------
# While testing, set this and EVERY wish goes here instead of to students.
# Leave blank to send for real.
TEST_EMAIL=

# Seconds to pause between messages, so the provider doesn't rate-limit you
SEND_DELAY_SECONDS=2

# ---- Daily report ------------------------------------------------------
# Get an email after every run saying what happened. Leave blank for none.
# This is how you know the automation is alive when it runs in the cloud.
REPORT_EMAIL=

# yes = report every day, even when nobody had a birthday (proves it ran)
# no  = only report on days something was sent or something failed
REPORT_ALWAYS=yes

# Put a copy of every student's wish in this inbox too. Usually leave blank.
BCC_EMAIL=

# ---- Student data source ----------------------------------------------
# "csv" | "xlsx" | "gsheet"
SOURCE_TYPE=csv
SOURCE_PATH=data/students.csv

# Only used when SOURCE_TYPE=gsheet
GSHEET_ID=
GSHEET_WORKSHEET=Form Responses 1
GOOGLE_CREDENTIALS_FILE=credentials.json

# ---- Poster ------------------------------------------------------------
# html  = the banner is drawn with HTML inside the email. Nothing to design,
#         and it still shows when a mail client blocks images.
# image = generate a PNG from the template below and embed it.
POSTER_MODE=html

# Only used when POSTER_MODE=image
POSTER_TEMPLATE=assets/template.png
POSTER_FONT=assets/font.ttf
