{
  "name": "birthday-email-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Birthday greetings for GCOERC - React dashboard + Cloudflare Worker API",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.web.json && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b tsconfig.json tsconfig.web.json --pretty",
    "db:local": "wrangler d1 migrations apply birthday-db --local",
    "db:remote": "wrangler d1 migrations apply birthday-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  }
}
