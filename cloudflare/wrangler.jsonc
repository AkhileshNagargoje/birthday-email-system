{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birthday-email-system",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React build. The Worker runs first for /api/*; everything else is
  // served straight from the assets, and unknown paths fall back to
  // index.html so client-side routing works.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 02:30 UTC = 08:00 IST. Cron is UTC only; India has no daylight saving,
  // so this stays correct all year.
  "triggers": {
    "crons": ["30 2 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birthday-db",
      "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "GCOERC",
    // "brevo" needs no domain. Switch to "cloudflare" once a domain is
    // onboarded with: wrangler email sending enable yourdomain.com
    "EMAIL_PROVIDER": "brevo",
    "SEND_FROM_EMAIL": "hymanper@gmail.com",
    "SEND_FROM_NAME": "GCOERC",
    "REPORT_EMAIL": "hymanper@gmail.com",
    // While set, every greeting goes here instead of to students.
    "TEST_EMAIL": ""
  },

  // Secrets (never in this file) - set with `wrangler secret put NAME`:
  //   DASH_USER      dashboard username
  //   DASH_PASS      dashboard password
  //   SESSION_SECRET long random string for signing login cookies
  //   BREVO_API_KEY  from brevo.com -> SMTP & API

  "observability": {
    "enabled": true
  }
}
