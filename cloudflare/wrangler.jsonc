{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birthday-email-system",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React build. The Worker runs first for /api/*; everything else is
  // served straight from the assets, and unknown paths fall back to
  // index.html so client-side routing works.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // DAILY SENDING LIVES IN GITHUB ACTIONS, not here - its submission path
  // proved to reach inboxes where the Worker's landed in spam. The Worker
  // keeps the dashboard and manual sends only. To move sending back, restore:
  //   "triggers": { "crons": ["30 2 * * *"] }   // 02:30 UTC = 08:00 IST
  "triggers": {
    "crons": []
  },

  // The dashboard's address. custom_domain makes Cloudflare create and manage
  // the DNS record for this subdomain automatically.
  "routes": [
    {
      "pattern": "birthday.akhileshnagargoje.in",
      "custom_domain": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birthday-db",
      "database_id": "2b311489-37a3-4751-9d89-89cd83c4ed6d",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "GCOERC",
    // "smtp"       Gmail directly, same as the Python version. Needs
    //              SMTP_USER + SMTP_PASS secrets (an app password).
    // "brevo"      HTTP API, needs BREVO_API_KEY.
    // "cloudflare" native binding, needs an onboarded domain (paid plan).
    "EMAIL_PROVIDER": "smtp",
    "SMTP_HOST": "smtp.gmail.com",
    // 465 = TLS from the first byte. 587 also works (STARTTLS).
    // Port 25 is blocked by Cloudflare and will not work.
    "SMTP_PORT": "465",
    // Used for the EHLO greeting and the Message-ID. Must be a domain that
    // resolves - a made-up hostname here reads as forgery to spam filters.
    "MAIL_DOMAIN": "akhileshnagargoje.in",
    "SEND_FROM_EMAIL": "hymanper@gmail.com",
    "SEND_FROM_NAME": "GCOERC",
    "REPLY_TO": "hymanper@gmail.com",
    "REPORT_EMAIL": "hymanper@gmail.com",
    // While set, every greeting goes here instead of to students.
    "TEST_EMAIL": ""
  },

  // Secrets (never in this file) - set with `wrangler secret put NAME`:
  //   DASH_USER      dashboard username
  //   DASH_PASS      dashboard password
  //   SESSION_SECRET long random string for signing login cookies
  //   BREVO_API_KEY  from brevo.com -> SMTP & API

  "observability": {
    "enabled": true
  }
}
